<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Inventory & Stock Manager</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js CDN for Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- html5-qrcode CDN for Barcode & QR Scanning -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        },
                        accent: {
                            500: '#6366f1',
                            600: '#4f46e5',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* Scanner Frame Effect */
        #qr-reader video {
            object-fit: cover !important;
            border-radius: 0.75rem;
        }
        #qr-reader {
            border: none !important;
        }
    </style>
</head>
<body class="h-full text-slate-800 flex flex-col md:flex-row overflow-hidden bg-slate-100">

    <!-- Sidebar Navigation -->
    <aside class="w-full md:w-64 bg-slate-900 text-slate-300 flex-shrink-0 flex flex-col justify-between border-r border-slate-800 z-20">
        <div>
            <!-- Logo / Header -->
            <div class="h-16 flex items-center justify-between px-6 bg-slate-950/50 border-b border-slate-800/80">
                <div class="flex items-center space-x-3">
                    <div class="p-2 bg-indigo-600 text-white rounded-lg shadow-lg">
                        <i class="fa-solid fa-boxes-stacked text-lg"></i>
                    </div>
                    <span class="font-bold text-lg text-white tracking-wide">StockPro</span>
                </div>
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Offline</span>
            </div>

            <!-- Navigation Links -->
            <nav class="p-4 space-y-1.5">
                <button id="nav-dashboard" onclick="switchTab('dashboard')" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all bg-indigo-600 text-white shadow-md shadow-indigo-600/20">
                    <i class="fa-solid fa-chart-pie w-5 text-center"></i>
                    <span>Dashboard</span>
                </button>
                <button id="nav-inventory" onclick="switchTab('inventory')" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all text-slate-400 hover:bg-slate-800 hover:text-slate-200">
                    <i class="fa-solid fa-box-archive w-5 text-center"></i>
                    <span>Inventory Items</span>
                </button>
            </nav>
        </div>

        <!-- Sidebar Quick Actions & Backup -->
        <div class="p-4 border-t border-slate-800 space-y-2">
            <button onclick="openModal()" class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-sm rounded-xl transition flex items-center justify-center space-x-2 shadow-lg shadow-emerald-900/30">
                <i class="fa-solid fa-plus"></i>
                <span>Add New Item</span>
            </button>
            
            <div class="pt-2 flex items-center justify-between text-xs text-slate-400 px-1">
                <span>Backup Data:</span>
                <div class="flex space-x-2">
                    <button onclick="exportData('json')" class="hover:text-white" title="Export JSON"><i class="fa-solid fa-download"></i> JSON</button>
                    <span>|</span>
                    <button onclick="exportData('csv')" class="hover:text-white" title="Export CSV"><i class="fa-solid fa-file-csv"></i> CSV</button>
                </div>
            </div>
            <label class="block w-full text-center py-1.5 text-xs text-slate-400 border border-dashed border-slate-700 hover:border-slate-500 rounded-lg cursor-pointer transition">
                <i class="fa-solid fa-upload mr-1"></i> Import Backup
                <input type="file" id="import-file" accept=".json" class="hidden" onchange="importData(event)">
            </label>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col h-full overflow-hidden bg-slate-50">
        
        <!-- Top App Bar -->
        <header class="h-16 bg-white border-b border-slate-200 px-4 md:px-8 flex items-center justify-between flex-shrink-0 z-10">
            <!-- Global Search Bar with Camera Scanner Button -->
            <div class="flex-1 max-w-xl relative flex items-center">
                <div class="relative w-full">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="global-search" oninput="handleSearchInput(this.value)" placeholder="Search product name, SKU, category..." 
                           class="w-full pl-10 pr-24 py-2 text-sm bg-slate-100 hover:bg-slate-100/80 focus:bg-white border border-transparent focus:border-indigo-500 rounded-xl outline-none transition font-medium">
                    <button onclick="openScanner('search')" class="absolute right-1 top-1/2 -translate-y-1/2 px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold flex items-center space-x-1.5 shadow transition">
                        <i class="fa-solid fa-qrcode"></i>
                        <span class="hidden sm:inline">Scan Code</span>
                    </button>
                </div>
            </div>

            <!-- Currency Toggle & System Status -->
            <div class="flex items-center space-x-4 ml-4">
                <div class="flex items-center bg-slate-100 p-1 rounded-lg border border-slate-200 text-xs font-semibold">
                    <button id="curr-usd" onclick="setCurrency('$')" class="px-2.5 py-1 rounded-md transition bg-white text-indigo-600 shadow-sm">$ (USD)</button>
                    <button id="curr-inr" onclick="setCurrency('₹')" class="px-2.5 py-1 rounded-md transition text-slate-600">₹ (INR)</button>
                </div>
            </div>
        </header>

        <!-- Dynamic Content Body -->
        <div class="flex-1 overflow-y-auto p-4 md:p-8">
            
            <!-- Dashboard Tab View -->
            <div id="tab-dashboard" class="space-y-6">
                <!-- Metrics Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Products</p>
                            <h3 id="stat-total-items" class="text-2xl font-bold text-slate-800 mt-1">0</h3>
                        </div>
                        <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-box"></i>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Stock Count</p>
                            <h3 id="stat-total-stock" class="text-2xl font-bold text-slate-800 mt-1">0</h3>
                        </div>
                        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-cubes"></i>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Stock Valuation</p>
                            <h3 id="stat-valuation" class="text-2xl font-bold text-slate-800 mt-1">$0.00</h3>
                        </div>
                        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-sack-dollar"></i>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Low Stock Alerts</p>
                            <h3 id="stat-low-stock" class="text-2xl font-bold text-amber-600 mt-1">0</h3>
                        </div>
                        <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                    </div>
                </div>

                <!-- Visual Charts Section -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
                        <h4 class="text-sm font-bold text-slate-800 mb-4 flex items-center justify-between">
                            <span>Category Distribution</span>
                            <i class="fa-solid fa-chart-pie text-slate-400"></i>
                        </h4>
                        <div class="h-64 relative flex items-center justify-center">
                            <canvas id="categoryChart"></canvas>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
                        <h4 class="text-sm font-bold text-slate-800 mb-4 flex items-center justify-between">
                            <span>Top Stock Volume Items</span>
                            <i class="fa-solid fa-chart-bar text-slate-400"></i>
                        </h4>
                        <div class="h-64 relative">
                            <canvas id="stockChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Inventory Tab View -->
            <div id="tab-inventory" class="hidden h-full flex flex-col lg:flex-row gap-6">
                <!-- Table View Container -->
                <div class="flex-1 bg-white rounded-2xl border border-slate-200/80 shadow-sm flex flex-col overflow-hidden">
                    <!-- Filters & Search Bar -->
                    <div class="p-4 border-b border-slate-100 bg-slate-50/50 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center space-x-2">
                            <select id="filter-category" onchange="renderInventory()" class="px-3 py-1.5 text-xs font-semibold bg-white border border-slate-200 rounded-lg outline-none focus:border-indigo-500">
                                <option value="ALL">All Categories</option>
                            </select>
                            <select id="filter-stock" onchange="renderInventory()" class="px-3 py-1.5 text-xs font-semibold bg-white border border-slate-200 rounded-lg outline-none focus:border-indigo-500">
                                <option value="ALL">All Stock Levels</option>
                                <option value="LOW">Low Stock Only</option>
                                <option value="OUT">Out of Stock</option>
                            </select>
                        </div>

                        <div class="text-xs text-slate-500 font-medium" id="item-count-label">
                            Showing 0 items
                        </div>
                    </div>

                    <!-- Table -->
                    <div class="flex-1 overflow-auto">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider sticky top-0">
                                <tr>
                                    <th class="py-3 px-4">Item</th>
                                    <th class="py-3 px-4">SKU / Barcode</th>
                                    <th class="py-3 px-4">Category</th>
                                    <th class="py-3 px-4">Price</th>
                                    <th class="py-3 px-4">Stock</th>
                                    <th class="py-3 px-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="inventory-table-body" class="divide-y divide-slate-100 text-sm">
                                <!-- Dynamic Rows -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Selected Item Details Side Preview Panel -->
                <div id="item-preview-panel" class="w-full lg:w-80 bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5 flex flex-col justify-between">
                    <div class="text-center text-slate-400 my-auto py-12" id="preview-empty">
                        <i class="fa-solid fa-hand-pointer text-4xl mb-3 opacity-40"></i>
                        <p class="text-sm font-medium">Select or Scan an item to view active details and adjust stock quickly.</p>
                    </div>

                    <div id="preview-content" class="hidden space-y-4">
                        <div class="relative w-full h-44 bg-slate-100 rounded-xl overflow-hidden border border-slate-200 flex items-center justify-center">
                            <img id="prev-image" src="" alt="Item Image" class="w-full h-full object-cover">
                            <div id="prev-img-placeholder" class="hidden text-slate-400 text-3xl">
                                <i class="fa-solid fa-box-open"></i>
                            </div>
                        </div>

                        <div>
                            <span id="prev-category" class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-600 mb-1">Category</span>
                            <h3 id="prev-name" class="text-lg font-bold text-slate-800 leading-snug">Product Name</h3>
                            <p id="prev-sku" class="text-xs font-mono text-slate-400 mt-0.5">SKU: 00000000</p>
                        </div>

                        <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 space-y-2">
                            <div class="flex justify-between items-center text-sm">
                                <span class="text-slate-500 font-medium">Unit Price:</span>
                                <span id="prev-price" class="font-bold text-slate-800">$0.00</span>
                            </div>
                            <div class="flex justify-between items-center text-sm">
                                <span class="text-slate-500 font-medium">Total Value:</span>
                                <span id="prev-total-val" class="font-bold text-slate-800">$0.00</span>
                            </div>
                            <div class="flex justify-between items-center text-sm">
                                <span class="text-slate-500 font-medium">Status:</span>
                                <span id="prev-status-badge">Badge</span>
                            </div>
                        </div>

                        <!-- Quick Quantity Adjuster -->
                        <div class="pt-2">
                            <label class="block text-xs font-semibold text-slate-500 mb-2">Adjust Quantity</label>
                            <div class="flex items-center space-x-2">
                                <button onclick="adjustStock(-1)" class="w-10 h-10 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold flex items-center justify-center transition">
                                    <i class="fa-solid fa-minus"></i>
                                </button>
                                <input type="number" id="prev-qty-input" class="flex-1 text-center font-bold text-lg border border-slate-200 rounded-xl h-10 outline-none focus:border-indigo-500" value="0">
                                <button onclick="adjustStock(1)" class="w-10 h-10 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold flex items-center justify-center transition">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                            <button onclick="saveStockAdjustment()" class="w-full mt-2 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl shadow transition">
                                Update Stock Count
                            </button>
                        </div>

                        <!-- Action Controls -->
                        <div class="flex space-x-2 pt-2">
                            <button onclick="editCurrentItem()" class="flex-1 py-2 border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs rounded-xl transition flex items-center justify-center space-x-1">
                                <i class="fa-solid fa-pen"></i>
                                <span>Edit</span>
                            </button>
                            <button onclick="deleteCurrentItem()" class="py-2 px-3 border border-red-200 hover:bg-red-50 text-red-600 font-semibold text-xs rounded-xl transition flex items-center justify-center">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- Camera QR/Barcode Scanner Modal Overlay -->
    <div id="scanner-modal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden flex flex-col">
            <div class="p-4 bg-slate-900 text-white flex justify-between items-center">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-camera text-indigo-400"></i>
                    <h3 class="font-bold text-sm">Scan QR / Barcode</h3>
                </div>
                <button onclick="closeScanner()" class="text-slate-400 hover:text-white text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            
            <div class="p-4 bg-black relative flex flex-col items-center">
                <!-- Camera Output Container -->
                <div id="qr-reader" class="w-full overflow-hidden rounded-xl bg-slate-950"></div>
                <p id="scanner-feedback" class="text-xs text-slate-300 mt-3 text-center">Position code inside viewfinder to auto-scan</p>
            </div>

            <div class="p-3 bg-slate-50 border-t border-slate-200 flex justify-between items-center text-xs">
                <span class="text-slate-500">Mode: <strong id="scanner-mode-label" class="text-indigo-600">Search</strong></span>
                <button onclick="closeScanner()" class="px-4 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium rounded-lg">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Add/Edit Product Modal -->
    <div id="item-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden my-8">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                <h3 id="modal-title" class="font-bold text-slate-800 text-lg">Add New Product</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="item-form" onsubmit="handleFormSubmit(event)" class="p-6 space-y-4">
                <input type="hidden" id="form-item-id">

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">Product Name *</label>
                    <input type="text" id="form-name" required placeholder="e.g. Wireless Mouse" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl outline-none focus:border-indigo-500">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">SKU / Barcode *</label>
                        <div class="flex space-x-1">
                            <input type="text" id="form-sku" required placeholder="SKU-1001" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl outline-none focus:border-indigo-500 font-mono">
                            <button type="button" onclick="openScanner('form')" class="px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold border border-slate-200" title="Scan Barcode to Fill">
                                <i class="fa-solid fa-barcode"></i>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">Category *</label>
                        <input type="text" id="form-category" required placeholder="Electronics" list="category-suggestions" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl outline-none focus:border-indigo-500">
                        <datalist id="category-suggestions"></datalist>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">Price (<span class="currency-label">$</span>) *</label>
                        <input type="number" id="form-price" step="0.01" min="0" required placeholder="0.00" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl outline-none focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">Initial Qty *</label>
                        <input type="number" id="form-qty" min="0" required placeholder="10" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl outline-none focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">Low Limit *</label>
                        <input type="number" id="form-threshold" min="0" required value="5" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl outline-none focus:border-indigo-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">Product Image</label>
                    <div class="flex items-center space-x-3">
                        <div id="form-img-preview-box" class="w-12 h-12 rounded-xl border border-slate-200 bg-slate-50 flex items-center justify-center overflow-hidden">
                            <i class="fa-solid fa-image text-slate-400"></i>
                        </div>
                        <input type="file" id="form-image-file" accept="image/*" onchange="handleImageUpload(event)" class="text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-600 hover:file:bg-indigo-100">
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 flex justify-end space-x-3">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 border border-slate-200 rounded-xl text-slate-600 text-sm font-semibold hover:bg-slate-50">Cancel</button>
                    <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow transition">Save Item</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Notification Toast Box -->
    <div id="toast" class="fixed bottom-5 right-5 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl border border-slate-700 text-sm flex items-center space-x-3 transition-all transform translate-y-20 opacity-0 z-50">
        <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toast-msg">Notification Message</span>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        // Sample Mock Initial Data
        const defaultInventory = [
            { id: '1', name: 'Logitech MX Master 3S', sku: 'LOG-MX3S-BLK', category: 'Electronics', price: 99.99, quantity: 18, threshold: 5, image: '' },
            { id: '2', name: 'Dell UltraSharp 27" Monitor', sku: 'DELL-U2723QE', category: 'Monitors', price: 549.50, quantity: 4, threshold: 5, image: '' },
            { id: '3', name: 'Keychron K2 Wireless Keyboard', sku: 'KEY-K2-RGB', category: 'Electronics', price: 79.00, quantity: 12, threshold: 3, image: '' },
            { id: '4', name: 'Ergonomic Desk Chair', sku: 'FURN-CHR-09', category: 'Furniture', price: 199.00, quantity: 2, threshold: 4, image: '' },
            { id: '5', name: 'USB-C Fast Charger 65W', sku: 'ANK-65W-PD', category: 'Accessories', price: 29.99, quantity: 45, threshold: 10, image: '' }
        ];

        // Global State variables
        let inventory = [];
        let currencySymbol = '$';
        let activeTab = 'dashboard';
        let selectedItemId = null;
        let formImageBase64 = '';
        let html5QrCode = null;
        let scannerMode = 'search'; // 'search' or 'form'
        let categoryChartInstance = null;
        let stockChartInstance = null;

        // Initialize App on DOM Load
        window.onload = function() {
            loadLocalData();
            initCharts();
            updateUI();
        };

        // Load persisted LocalStorage data
        function loadLocalData() {
            const savedData = localStorage.getItem('stockpro_inventory');
            if (savedData) {
                try {
                    inventory = JSON.parse(savedData);
                } catch(e) {
                    inventory = defaultInventory;
                }
            } else {
                inventory = defaultInventory;
                saveLocalData();
            }

            const savedCurr = localStorage.getItem('stockpro_currency');
            if (savedCurr) setCurrency(savedCurr, false);
        }

        // Save data back to LocalStorage
        function saveLocalData() {
            localStorage.setItem('stockpro_inventory', JSON.stringify(inventory));
        }

        // Toggle View Tabs
        function switchTab(tabName) {
            activeTab = tabName;
            document.getElementById('tab-dashboard').classList.toggle('hidden', tabName !== 'dashboard');
            document.getElementById('tab-inventory').classList.toggle('hidden', tabName !== 'inventory');

            const dashNav = document.getElementById('nav-dashboard');
            const invNav = document.getElementById('nav-inventory');

            if (tabName === 'dashboard') {
                dashNav.className = "w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all bg-indigo-600 text-white shadow-md shadow-indigo-600/20";
                invNav.className = "w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all text-slate-400 hover:bg-slate-800 hover:text-slate-200";
                updateCharts();
            } else {
                invNav.className = "w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all bg-indigo-600 text-white shadow-md shadow-indigo-600/20";
                dashNav.className = "w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all text-slate-400 hover:bg-slate-800 hover:text-slate-200";
            }
        }

        // Currency Switcher
        function setCurrency(symbol, update = true) {
            currencySymbol = symbol;
            localStorage.setItem('stockpro_currency', symbol);
            
            document.getElementById('curr-usd').className = symbol === '$' ? 'px-2.5 py-1 rounded-md transition bg-white text-indigo-600 shadow-sm font-bold' : 'px-2.5 py-1 rounded-md transition text-slate-600';
            document.getElementById('curr-inr').className = symbol === '₹' ? 'px-2.5 py-1 rounded-md transition bg-white text-indigo-600 shadow-sm font-bold' : 'px-2.5 py-1 rounded-md transition text-slate-600';

            document.querySelectorAll('.currency-label').forEach(el => el.textContent = symbol);

            if (update) updateUI();
        }

        // Search Input Handling
        function handleSearchInput(val) {
            if (activeTab !== 'inventory') switchTab('inventory');
            renderInventory();

            // Auto select if unique barcode match found
            const query = val.trim().toLowerCase();
            if (query) {
                const match = inventory.find(i => i.sku.toLowerCase() === query);
                if (match) selectItem(match.id);
            }
        }

        // Update Dashboard Metrics and Data
        function updateUI() {
            // Metrics
            const totalItems = inventory.length;
            const totalStock = inventory.reduce((sum, item) => sum + Number(item.quantity), 0);
            const totalValuation = inventory.reduce((sum, item) => sum + (Number(item.quantity) * Number(item.price)), 0);
            const lowStockCount = inventory.filter(item => Number(item.quantity) <= Number(item.threshold)).length;

            document.getElementById('stat-total-items').textContent = totalItems;
            document.getElementById('stat-total-stock').textContent = totalStock;
            document.getElementById('stat-valuation').textContent = `${currencySymbol}${totalValuation.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById('stat-low-stock').textContent = lowStockCount;

            // Populate Category Filter Dropdown
            const categories = [...new Set(inventory.map(i => i.category))];
            const filterCat = document.getElementById('filter-category');
            const currentCatVal = filterCat.value;
            filterCat.innerHTML = '<option value="ALL">All Categories</option>' + categories.map(c => `<option value="${c}">${c}</option>`).join('');
            filterCat.value = currentCatVal;

            // Datalist for Form
            document.getElementById('category-suggestions').innerHTML = categories.map(c => `<option value="${c}">`).join('');

            renderInventory();
            updateCharts();
            if (selectedItemId) updatePreviewPanel();
        }

        // Render Inventory Table Grid
        function renderInventory() {
            const tbody = document.getElementById('inventory-table-body');
            const searchVal = document.getElementById('global-search').value.toLowerCase().trim();
            const catFilter = document.getElementById('filter-category').value;
            const stockFilter = document.getElementById('filter-stock').value;

            const filtered = inventory.filter(item => {
                const matchesSearch = item.name.toLowerCase().includes(searchVal) || 
                                      item.sku.toLowerCase().includes(searchVal) || 
                                      item.category.toLowerCase().includes(searchVal);
                
                const matchesCat = catFilter === 'ALL' || item.category === catFilter;
                
                let matchesStock = true;
                if (stockFilter === 'LOW') matchesStock = item.quantity <= item.threshold && item.quantity > 0;
                if (stockFilter === 'OUT') matchesStock = item.quantity === 0;

                return matchesSearch && matchesCat && matchesStock;
            });

            document.getElementById('item-count-label').textContent = `Showing ${filtered.length} of ${inventory.length} items`;

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-slate-400">No matching inventory items found.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(item => {
                const isSelected = item.id === selectedItemId;
                const isLow = item.quantity <= item.threshold;
                const isOut = item.quantity === 0;

                let badge = `<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">In Stock</span>`;
                if (isOut) badge = `<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700">Out of Stock</span>`;
                else if (isLow) badge = `<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">Low Stock</span>`;

                return `
                    <tr onclick="selectItem('${item.id}')" class="cursor-pointer transition hover:bg-slate-50 ${isSelected ? 'bg-indigo-50/60 font-medium' : ''}">
                        <td class="py-3 px-4 flex items-center space-x-3">
                            <div class="w-9 h-9 rounded-lg bg-slate-100 border border-slate-200 overflow-hidden flex-shrink-0 flex items-center justify-center">
                                ${item.image ? `<img src="${item.image}" class="w-full h-full object-cover">` : `<i class="fa-solid fa-box text-slate-400 text-xs"></i>`}
                            </div>
                            <span class="text-slate-800 font-semibold truncate max-w-[160px]">${item.name}</span>
                        </td>
                        <td class="py-3 px-4 text-xs font-mono text-slate-500">${item.sku}</td>
                        <td class="py-3 px-4 text-xs text-slate-600">${item.category}</td>
                        <td class="py-3 px-4 font-semibold text-slate-800">${currencySymbol}${Number(item.price).toFixed(2)}</td>
                        <td class="py-3 px-4">
                            <div class="flex items-center space-x-2">
                                <span class="font-bold ${isOut ? 'text-red-600' : isLow ? 'text-amber-600' : 'text-slate-800'}">${item.quantity}</span>
                                ${badge}
                            </div>
                        </td>
                        <td class="py-3 px-4 text-right space-x-1" onclick="event.stopPropagation()">
                            <button onclick="quickAdjust('${item.id}', 1)" class="p-1.5 hover:bg-slate-200 rounded text-slate-600" title="Add 1"><i class="fa-solid fa-plus text-xs"></i></button>
                            <button onclick="quickAdjust('${item.id}', -1)" class="p-1.5 hover:bg-slate-200 rounded text-slate-600" title="Remove 1"><i class="fa-solid fa-minus text-xs"></i></button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Select item for details preview panel
        function selectItem(id) {
            selectedItemId = id;
            renderInventory();
            updatePreviewPanel();
        }

        // Render side preview detail panel
        function updatePreviewPanel() {
            const item = inventory.find(i => i.id === selectedItemId);
            const emptyState = document.getElementById('preview-empty');
            const contentState = document.getElementById('preview-content');

            if (!item) {
                emptyState.classList.remove('hidden');
                contentState.classList.add('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            contentState.classList.remove('hidden');

            document.getElementById('prev-name').textContent = item.name;
            document.getElementById('prev-sku').textContent = `SKU: ${item.sku}`;
            document.getElementById('prev-category').textContent = item.category;
            document.getElementById('prev-price').textContent = `${currencySymbol}${Number(item.price).toFixed(2)}`;
            document.getElementById('prev-total-val').textContent = `${currencySymbol}${(item.quantity * item.price).toFixed(2)}`;
            document.getElementById('prev-qty-input').value = item.quantity;

            const imgEl = document.getElementById('prev-image');
            const placeholderEl = document.getElementById('prev-img-placeholder');
            if (item.image) {
                imgEl.src = item.image;
                imgEl.classList.remove('hidden');
                placeholderEl.classList.add('hidden');
            } else {
                imgEl.classList.add('hidden');
                placeholderEl.classList.remove('hidden');
            }

            const badgeEl = document.getElementById('prev-status-badge');
            if (item.quantity === 0) {
                badgeEl.className = "px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700";
                badgeEl.textContent = "Out of Stock";
            } else if (item.quantity <= item.threshold) {
                badgeEl.className = "px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700";
                badgeEl.textContent = "Low Stock Alert";
            } else {
                badgeEl.className = "px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700";
                badgeEl.textContent = "In Stock";
            }
        }

        // Stock Increment/Decrement Logic
        function adjustStock(delta) {
            const input = document.getElementById('prev-qty-input');
            let val = parseInt(input.value) || 0;
            val = Math.max(0, val + delta);
            input.value = val;
        }

        function saveStockAdjustment() {
            if (!selectedItemId) return;
            const item = inventory.find(i => i.id === selectedItemId);
            if (item) {
                const newQty = parseInt(document.getElementById('prev-qty-input').value) || 0;
                item.quantity = newQty;
                saveLocalData();
                updateUI();
                showToast(`Stock updated for ${item.name}`);
            }
        }

        function quickAdjust(id, delta) {
            const item = inventory.find(i => i.id === id);
            if (item) {
                item.quantity = Math.max(0, parseInt(item.quantity) + delta);
                saveLocalData();
                updateUI();
                showToast(`Updated ${item.name} stock to ${item.quantity}`);
            }
        }

        // CAMERA SCANNER FUNCTIONALITY (html5-qrcode integration)
        function openScanner(mode = 'search') {
            scannerMode = mode;
            document.getElementById('scanner-mode-label').textContent = mode === 'search' ? 'Search & Select Item' : 'Fill SKU Input';
            document.getElementById('scanner-modal').classList.remove('hidden');

            if (!html5QrCode) {
                html5QrCode = new Html5Qrcode("qr-reader");
            }

            const config = { fps: 10, qrbox: { width: 220, height: 220 } };

            html5QrCode.start({ facingMode: "environment" }, config, onScanSuccess)
            .catch(err => {
                document.getElementById('scanner-feedback').textContent = "Camera permission denied or unavailable.";
                console.error("Camera start error:", err);
            });
        }

        function onScanSuccess(decodedText) {
            closeScanner();
            showToast(`Scanned Code: ${decodedText}`);

            if (scannerMode === 'search') {
                const searchInput = document.getElementById('global-search');
                searchInput.value = decodedText;
                handleSearchInput(decodedText);
            } else if (scannerMode === 'form') {
                document.getElementById('form-sku').value = decodedText;
            }
        }

        function closeScanner() {
            if (html5QrCode && html5QrCode.isScanning) {
                html5QrCode.stop().then(() => {
                    document.getElementById('scanner-modal').classList.add('hidden');
                }).catch(err => {
                    document.getElementById('scanner-modal').classList.add('hidden');
                });
            } else {
                document.getElementById('scanner-modal').classList.add('hidden');
            }
        }

        // Product Form Modal Management
        function openModal(editId = null) {
            const modal = document.getElementById('item-modal');
            const form = document.getElementById('item-form');
            form.reset();
            formImageBase64 = '';
            document.getElementById('form-img-preview-box').innerHTML = `<i class="fa-solid fa-image text-slate-400"></i>`;

            if (editId) {
                const item = inventory.find(i => i.id === editId);
                if (item) {
                    document.getElementById('modal-title').textContent = "Edit Product";
                    document.getElementById('form-item-id').value = item.id;
                    document.getElementById('form-name').value = item.name;
                    document.getElementById('form-sku').value = item.sku;
                    document.getElementById('form-category').value = item.category;
                    document.getElementById('form-price').value = item.price;
                    document.getElementById('form-qty').value = item.quantity;
                    document.getElementById('form-threshold').value = item.threshold;
                    if (item.image) {
                        formImageBase64 = item.image;
                        document.getElementById('form-img-preview-box').innerHTML = `<img src="${item.image}" class="w-full h-full object-cover">`;
                    }
                }
            } else {
                document.getElementById('modal-title').textContent = "Add New Product";
                document.getElementById('form-item-id').value = '';
            }

            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('item-modal').classList.add('hidden');
        }

        function handleImageUpload(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    formImageBase64 = evt.target.result;
                    document.getElementById('form-img-preview-box').innerHTML = `<img src="${formImageBase64}" class="w-full h-full object-cover">`;
                };
                reader.readAsDataURL(file);
            }
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('form-item-id').value;
            const name = document.getElementById('form-name').value.trim();
            const sku = document.getElementById('form-sku').value.trim();
            const category = document.getElementById('form-category').value.trim();
            const price = parseFloat(document.getElementById('form-price').value) || 0;
            const quantity = parseInt(document.getElementById('form-qty').value) || 0;
            const threshold = parseInt(document.getElementById('form-threshold').value) || 0;

            if (id) {
                // Edit existing
                const idx = inventory.findIndex(i => i.id === id);
                if (idx !== -1) {
                    inventory[idx] = { id, name, sku, category, price, quantity, threshold, image: formImageBase64 || inventory[idx].image };
                    showToast(`Updated product ${name}`);
                }
            } else {
                // Create new
                const newItem = {
                    id: Date.now().toString(),
                    name, sku, category, price, quantity, threshold,
                    image: formImageBase64
                };
                inventory.push(newItem);
                selectedItemId = newItem.id;
                showToast(`Added product ${name}`);
            }

            saveLocalData();
            closeModal();
            updateUI();
        }

        function editCurrentItem() {
            if (selectedItemId) openModal(selectedItemId);
        }

        function deleteCurrentItem() {
            if (!selectedItemId) return;
            const item = inventory.find(i => i.id === selectedItemId);
            if (item && confirm(`Are you sure you want to delete "${item.name}"?`)) {
                inventory = inventory.filter(i => i.id !== selectedItemId);
                selectedItemId = null;
                saveLocalData();
                updateUI();
                showToast(`Item removed`);
            }
        }

        // Backup Export & Import Functions
        function exportData(type) {
            if (type === 'json') {
                const blob = new Blob([JSON.stringify(inventory, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `inventory_backup_${new Date().toISOString().slice(0,10)}.json`;
                a.click();
            } else if (type === 'csv') {
                const headers = ["ID", "Name", "SKU", "Category", "Price", "Quantity", "LowThreshold"];
                const rows = inventory.map(i => [i.id, `"${i.name}"`, `"${i.sku}"`, `"${i.category}"`, i.price, i.quantity, i.threshold]);
                const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(r => r.join(","))].join("\n");
                const encodedUri = encodeURI(csvContent);
                const a = document.createElement('a');
                a.href = encodedUri;
                a.download = `inventory_export_${new Date().toISOString().slice(0,10)}.csv`;
                a.click();
            }
        }

        function importData(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (Array.isArray(imported)) {
                        inventory = imported;
                        saveLocalData();
                        updateUI();
                        showToast("Inventory backup restored successfully!");
                    } else {
                        showToast("Invalid backup file structure.");
                    }
                } catch(err) {
                    showToast("Failed to parse imported file.");
                }
            };
            reader.readAsText(file);
        }

        // Notification Toast Display
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Chart.js Visualization Logic
        function initCharts() {
            const ctxCat = document.getElementById('categoryChart').getContext('2d');
            categoryChartInstance = new Chart(ctxCat, {
                type: 'doughnut',
                data: { labels: [], datasets: [{ data: [], backgroundColor: ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#06b6d4'] }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });

            const ctxStock = document.getElementById('stockChart').getContext('2d');
            stockChartInstance = new Chart(ctxStock, {
                type: 'bar',
                data: { labels: [], datasets: [{ label: 'Stock Quantity', data: [], backgroundColor: '#6366f1', borderRadius: 6 }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });
        }

        function updateCharts() {
            if (!categoryChartInstance || !stockChartInstance) return;

            // Category Distribution Data
            const catCounts = {};
            inventory.forEach(i => catCounts[i.category] = (catCounts[i.category] || 0) + Number(i.quantity));
            
            categoryChartInstance.data.labels = Object.keys(catCounts);
            categoryChartInstance.data.datasets[0].data = Object.values(catCounts);
            categoryChartInstance.update();

            // Top Stock Items Data
            const sortedItems = [...inventory].sort((a,b) => b.quantity - a.quantity).slice(0, 5);
            stockChartInstance.data.labels = sortedItems.map(i => i.name.length > 12 ? i.name.slice(0, 12) + '...' : i.name);
            stockChartInstance.data.datasets[0].data = sortedItems.map(i => i.quantity);
            stockChartInstance.update();
        }
    </script>
</body>
</html>
